<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Sheet metal domain logic, pure managed and free of NXOpen so it targets net8.0 as well as net48 and
    stays unit-testable without an NX session. Building it does need NX installed, though: the JSON readers
    bind against the Newtonsoft.Json that NX itself ships (see the reference below).

    One folder per feature (Beads\, and Louvers\/Joggles\ as they arrive) over shared Common\, SpecData\
    and Materials\ layers, rather than an assembly per feature: the shared spec-workbook parsing and
    sheet metal material table have an obvious home, and the number of DLLs deployed into NX does not grow with the
    number of features.
  -->

  <ItemGroup>
    <ProjectReference Include="..\..\..\BANxOpen.Foundation\src\BANxOpen.Foundation.Contracts\BANxOpen.Foundation.Contracts.csproj" />
    <ProjectReference Include="..\..\..\BANxOpen.Foundation\src\BANxOpen.Foundation.Core\BANxOpen.Foundation.Core.csproj" />
    <!-- The material engine: this project supplies IFeatureMaterialConstraintProvider implementations
         so the shared assignment pipeline can enforce sheet metal restrictions. -->
    <ProjectReference Include="..\..\..\BANxOpen.Foundation\src\BANxOpen.Foundation.Core.Materials\BANxOpen.Foundation.Core.Materials.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reads the SPEC workbooks (SpecData\ExcelBeadSpecParser.cs). Pure managed, no NXOpen dependency,
         so it can live here and be unit-tested without an NX session. OpenXml rather than ClosedXML: ClosedXML's
         dependencies (System.Memory/Buffers/Numerics.Vectors, SixLabors.Fonts) need binding redirects, which NX
         never reads from a plug-in; OpenXml references framework assemblies only. -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.0.1" />
  </ItemGroup>

  <!--
    Serializes the parsed spec cache and reads the bead and sheet metal settings (SpecData\BeadSpecCache.cs,
    Beads\BeadSettings.cs, Common\SheetMetalSettings.cs) with the same Newtonsoft.Json NX itself
    loads (13.0.1, from NXBIN\managed), so a tool running inside NX never binds against a second copy.
    Referenced through UGII_BASE_DIR, never a hardcoded install path — Skills/nxopen-csharp-patterns §4.
  -->
  <Target Name="RequireUgiiBaseDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(UGII_BASE_DIR)' == ''"
           Text="UGII_BASE_DIR is not set. This project references Newtonsoft.Json from the NX installation (NXBIN\managed) and can only be built on a machine with NX installed." />
  </Target>

  <ItemGroup>
    <!-- Copy-local, unlike the NXOpen references in the NxAdapters projects: the net8.0 unit tests need the
         assembly beside the test binaries. Inside NX the copy is redundant but harmless — the identical version is
         already loaded from NX's own folder. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(UGII_BASE_DIR)\NXBIN\managed\Newtonsoft.Json.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>

</Project>