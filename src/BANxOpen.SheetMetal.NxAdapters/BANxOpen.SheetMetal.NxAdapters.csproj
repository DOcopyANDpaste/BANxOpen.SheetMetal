<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The NX side of the sheet metal domain: reading a body's thickness and material, creating and editing
    features, stamping and tracing provenance attributes. No BlockStyler and no WinForms, so a batch
    caller or a different front end can use it; the dialogs live in the BANxOpen.Ui.SheetMetal.* repos.

    In the solution for IntelliSense with an ActiveCfg entry and NO Build.0 entry in any configuration:
    it references real NXOpen assemblies that only resolve where NX is installed (UGII_BASE_DIR set), so
    building it by default would break `dotnet build`/`dotnet test` everywhere else. Build it explicitly
    on an NX machine:
    `dotnet build src\BANxOpen.SheetMetal.NxAdapters\BANxOpen.SheetMetal.NxAdapters.csproj`.
  -->

  <Target Name="RequireUgiiBaseDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(UGII_BASE_DIR)' == ''"
           Text="UGII_BASE_DIR is not set. This project references the NXOpen managed assemblies and can only be built on a machine with NX installed." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\BANxOpen.SheetMetal.Core\BANxOpen.SheetMetal.Core.csproj" />
    <!--
      Foundation Contracts/Core arrive transitively via SheetMetal.Core, but are listed explicitly since
      this project uses their types directly. NxAdapters (NxSessionContext, UndoScope, NxListingLog,
      NxMessageBoxHelper, and the material PartMaterialService) has no other path in and must be listed.
    -->
    <ProjectReference Include="..\..\..\BANxOpen.Foundation\src\BANxOpen.Foundation.Contracts\BANxOpen.Foundation.Contracts.csproj" />
    <ProjectReference Include="..\..\..\BANxOpen.Foundation\src\BANxOpen.Foundation.Core\BANxOpen.Foundation.Core.csproj" />
    <ProjectReference Include="..\..\..\BANxOpen.Foundation\src\BANxOpen.Foundation.Core.Materials\BANxOpen.Foundation.Core.Materials.csproj" />
    <ProjectReference Include="..\..\..\BANxOpen.Foundation\src\BANxOpen.Foundation.NxAdapters\BANxOpen.Foundation.NxAdapters.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>

  <!-- Per Skills/common.md non-negotiable #4: no hardcoded install paths, reference via UGII_BASE_DIR.
       Managed assemblies live in NXBIN\managed for net48 (NXBIN\managed_core is the .NET-Core copy). -->
  <PropertyGroup>
    <NxManagedDir>$(UGII_BASE_DIR)\NXBIN\managed</NxManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="NXOpen">
      <HintPath>$(NxManagedDir)\NXOpen.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="NXOpen.UF">
      <HintPath>$(NxManagedDir)\NXOpen.UF.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="NXOpen.Utilities">
      <HintPath>$(NxManagedDir)\NXOpen.Utilities.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>