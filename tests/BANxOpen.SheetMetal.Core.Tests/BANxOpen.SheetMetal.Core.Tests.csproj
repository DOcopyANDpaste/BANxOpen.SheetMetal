<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Builds test workbooks only; the parser itself reads with DocumentFormat.OpenXml. 0.95.4 is the last
         ClosedXML that accepts OpenXml 2.9.0, so the tests run the parser on the same OpenXml NX loads. -->
    <PackageReference Include="ClosedXML" Version="0.95.4" />
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BANxOpen.SheetMetal.Core\BANxOpen.SheetMetal.Core.csproj" />
  </ItemGroup>

</Project>